  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^35.2.1",
    "electron-builder": "^24.6.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.6.2",
