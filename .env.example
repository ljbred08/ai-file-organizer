# Copy this file to .env and fill in real values. Never commit .env.

# --- Chat / LLM provider (OpenAI-compatible) ---
# Required for "Smart Rename Folders". Defaults to OpenRouter when AI_BASE_URL is unset.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Embeddings ---
# Required. Voyage AI is the default embedding provider.
VOYAGE_API_KEY=

# --- Optional ---
# Only needed if you switch to the jina-clip-v2 or imagebind embedding models
# (see src/electron/embeddingUtils.ts).
REPLICATE_API_TOKEN=
